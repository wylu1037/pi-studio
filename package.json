{
  "name": "pi-studio",
  "version": "0.1.0",
  "description": "A local-first desktop control panel for Pi agents.",
  "author": "Pi Studio contributors",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "PI_STUDIO_DATA_DIR=data next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "app:dev": "electron .",
    "app:icons": "bash scripts/generate-app-icons.sh",
    "app:prepare": "node scripts/prepare-electron.mjs",
    "app:rebuild": "node scripts/rebuild-electron-native.mjs",
    "app:bundle": "pnpm build && pnpm app:prepare && pnpm app:rebuild",
    "app:build:dir": "pnpm app:bundle && electron-builder --projectDir electron --config ../electron-builder.yml --dir",
    "app:build": "pnpm app:bundle && electron-builder --projectDir electron --config ../electron-builder.yml",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx lib/db/seed.ts",
    "api:schema": "tsx scripts/write-openapi.ts",
    "api:gen": "pnpm run api:schema && kubb generate",
    "pi:version": "pi --version"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@hono/zod-openapi": "^1.5.1",
    "@hookform/resolvers": "^5.5.7",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/analytics": "2.0.1",
    "axios": "^1.18.1",
    "better-sqlite3": "^13.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.6.2",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "hono": "4.12.32",
    "katex": "^0.18.1",
    "lucide-react": "^1.27.0",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.56.0",
    "motion": "^12.42.2",
    "next": "16.2.12",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "recharts": "3.10.1",
    "shadcn": "^4.16.0",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "typebox": "^1.3.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@kubb/plugin-axios": "5.0.0-beta.99",
    "@kubb/plugin-client": "4.39.2",
    "@kubb/plugin-oas": "^4.39.2",
    "@kubb/plugin-react-query": "^4.39.2",
    "@kubb/plugin-ts": "^4.39.2",
    "@kubb/plugin-zod": "^4.39.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/katex": "^0.16.8",
    "@types/node": "^22",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "electron": "43.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.8.0",
    "kubb": "^3.2.2",
    "node-gyp": "^13.0.1",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.65.0"
  }
}
